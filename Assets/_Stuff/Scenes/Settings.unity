  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Mang Nando is a local Taho vendor, selling one of the most favorite breakfast
    of Filipinos!\r\n\r\nTo sell them, he needs to find customers in the streets
    by moving with WASD keys. \r\n\r\nAs long as you see that they\u2019re interested
    in Taho, they\u2019ll come to you quickly!\r\n\r\nTo make Taho, click the cup
    to serve, and you must CLICK your mouse and DRAG it to the cup.\r\n\r\nPut the
    ingredients according to how much serving they want. These ingredients include
    TOFU (show icon), ARNIBAL (show icon), and SAGO (show icon).\r\n\r\nCLICK this
    button to mix. If you mess up the order, CLICK this button to throw it away.\r\n\r\nOnce
    ready, CLICK the Taho once, and it\u2019ll be sold to the customer.\r\n\r\nYou
    can make and sell taho until the clock reaches 20:00. You can also dice to end
    the day after 12:00.\r\n\r\nTry to make and sell as much as you can before the
    day ends! Good luck!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c723cc154a20ade4f83f1847cba48de2, type: 2}
